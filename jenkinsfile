pipeline {
    agent any

    tools {
        jdk 'JDK21'
    }

    stages {

        stage('Checkout code') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/majda-soussia/GIT-REPO.git'
            }
        }

        stage('Compile code') {
            steps {
                sh '''
                cd src
                javac application/Test.java
                '''
            }
        }

        stage('Execute code') {
            steps {
                sh '''
                cd src
                java application.Test
                '''
            }
        }
    }
}
